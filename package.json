{
  "name": "bobineweb",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Site web de Bobine — vitrine, documentation et tutoriel d'installation.",
  "homepage": "https://bobine.fit",
  "repository": {
    "type": "git",
    "url": "https://github.com/FantasmaGlad/BobineWeb.git"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:onion": "node scripts/prepare-onion.mjs && NEXT_PUBLIC_BOBINE_ONION=1 next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test scripts/ci/*.test.mjs && npm run test:rag",
    "sync:rag": "tsx scripts/rag/sync.ts",
    "prebuild": "node scripts/ci/sync-install.mjs",
    "prebuild:onion": "node scripts/ci/sync-install.mjs",
    "check:rag": "tsx scripts/rag/sync.ts --dry-run",
    "test:rag": "tsx --test scripts/rag/*.test.ts"
  },
  "dependencies": {
    "@google-cloud/discoveryengine": "^3.4.0",
    "@mdx-js/loader": "^3",
    "@mdx-js/react": "^3",
    "@next/mdx": "^16.4.3",
    "@react-pdf/renderer": "^4.9.0",
    "@vercel/analytics": "^2.0.1",
    "google-auth-library": "^11.3.1",
    "next": "^16.4.3",
    "openai": "^7.43.0",
    "parse5": "^8.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/mdx": "^2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "critters": "^0.0.25",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "browserslist": [
    "Chrome >= 109",
    "Edge >= 109",
    "Firefox >= 115",
    "Safari >= 15.4",
    "iOS >= 15.4",
    "Samsung >= 20"
  ]
}
