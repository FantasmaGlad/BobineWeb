[Unit]
Description=Miroir Tor de Bobine : synchronisation du depot APT et du site
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=onion-sync
Group=onion-data
Environment=HOME=/var/lib/onion-sync ONION_SYNC_STATE=/var/lib/onion-sync
UMask=0027
ExecStart=/usr/local/lib/bobine-onion/sync.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/onion /var/lib/onion-sync
