# Optionnel — augmente la limite de taux de l'API GitHub utilisée pour lister
# les releases dans /blog (60 req/h sans token, 5000 req/h avec).
# Créer un token "public repo read-only" sur https://github.com/settings/tokens
GITHUB_TOKEN=

