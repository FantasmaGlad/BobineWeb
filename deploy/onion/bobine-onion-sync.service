[Unit]
Description=Miroir Tor de Bobine : synchronisation du depot APT et du site
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Seul utilisateur à lire la clé de déploiement GitHub (/var/lib/onion-sync/.ssh, mode 0700) ; le serveur web tourne sous
# onion-web et ne peut pas l'ouvrir. Groupe onion-data : les copies écrites dans /srv/onion lui sont lisibles.
User=onion-sync
Group=onion-data
Environment=HOME=/var/lib/onion-sync ONION_SYNC_STATE=/var/lib/onion-sync
UMask=0027
ExecStart=/usr/local/lib/bobine-onion/sync.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/onion /var/lib/onion-sync
