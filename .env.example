# Optionnel — augmente la limite de taux de l'API GitHub utilisée pour lister
# les releases dans /blog (60 req/h sans token, 5000 req/h avec).
# Créer un token "public repo read-only" sur https://github.com/settings/tokens
GITHUB_TOKEN=


# Cloudflare, zone bobine.fit (Email Routing, DNS). Jeton avec droits sur la zone et le compte ;
# uniquement en local, jamais dans le code ni sur Vercel sans besoin.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Synchronisation documentaire (hors application web)
RAG_BUCKET=bobine-knowledge-prod
# BOBINE_SOURCE_DIR : chemin du checkout canonique Bobine pour les scripts locaux et CI.
