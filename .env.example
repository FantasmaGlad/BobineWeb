# Optionnel — augmente la limite de taux de l'API GitHub utilisée pour lister
# les releases dans /blog (60 req/h sans token, 5000 req/h avec).
# Créer un token "public repo read-only" sur https://github.com/settings/tokens
GITHUB_TOKEN=

# Baamix : Génération via Hugging Face (DeepSeek V4.1 Flash, token avec droit d'inférence).
# HF_MODEL (optionnel) permet de forcer un autre modèle.
HF_TOKEN=
HF_MODEL=

# RAG Google Cloud Vertex AI Search (Optionnel - Boost sémantique)
# Si non défini ou false, Baamix utilise la base de connaissances statique locale sans aucune erreur.
ENABLE_VERTEX_RAG=false
GCP_PROJECT_ID=malefiquevirtualmachine
GCP_LOCATION=global
VERTEX_DATA_STORE_ID=bobine-web-store
# Sur Vercel uniquement : JSON du compte de service encodé en Base64 (en local, gcloud ADC est utilisé)
GCP_SERVICE_ACCOUNT_KEY=

# AliExpress Affiliate API
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# Cloudflare, zone bobine.fit (Email Routing, DNS). Jeton avec droits sur la zone et le compte ;
# uniquement en local, jamais dans le code ni sur Vercel sans besoin.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Synchronisation documentaire (hors application web)
RAG_BUCKET=bobine-knowledge-prod
# BOBINE_SOURCE_DIR : chemin du checkout canonique Bobine pour les scripts locaux et CI.
