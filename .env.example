# Optionnel — augmente la limite de taux de l'API GitHub utilisée pour lister
# les releases dans /blog (60 req/h sans token, 5000 req/h avec).
# Créer un token "public repo read-only" sur https://github.com/settings/tokens
GITHUB_TOKEN=

# Baamix : Hugging Face en premier (DeepSeek V4.1 Flash, token avec droit d'inférence), OpenRouter en repli.
# Au moins une des deux clés est requise. HF_MODEL / OPENROUTER_MODEL (optionnels) forcent un autre modèle.
HF_TOKEN=
OPENROUTER_API_KEY=

# AliExpress Affiliate API (voir docs/cahier-des-charges-aliexpress-affiliate.md)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
