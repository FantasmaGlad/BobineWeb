[Unit]
Description=Miroir Tor de Bobine : serveur statique (sockets UNIX locaux)
After=network.target

[Service]
User=onion-web
Group=debian-tor
SupplementaryGroups=onion-data
RuntimeDirectory=onion
RuntimeDirectoryMode=0750
Environment=XDG_DATA_HOME=/var/lib/bobine-onion XDG_CONFIG_HOME=/var/lib/bobine-onion
StateDirectory=bobine-onion
ExecStart=/usr/bin/caddy run --config /etc/bobine-onion/Caddyfile --adapter caddyfile
Restart=on-failure

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadOnlyPaths=/srv/onion
InaccessiblePaths=/var/lib/onion-sync /var/lib/onion
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
UMask=0027

[Install]
WantedBy=multi-user.target
