# Ce dépôt ne publie que ce qui est nécessaire pour construire et faire tourner le site.
# Tout ce qui est généré, secret ou propre à une machine reste hors de Git.

# --- Dépendances ---
/node_modules
.pnp
.pnp.*

# --- Construction ---
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts.tsbuildinfo
.turbo/
coverage/
playwright-report/
test-results/

# --- Variables d'environnement : seul le modèle est versionné ---
.env
.env.*
!.env.example

# --- Clés, certificats et identifiants : jamais dans le dépôt ---
# Les clés PUBLIQUES du site (public/.well-known/) ne sont pas concernées.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.csr
id_rsa*
id_ed25519*
id_ecdsa*
hs_ed25519_*
*.kdbx
*.secret
*.secrets
secrets/
.secrets/
credentials*.json
service-account*.json
*-service-account.json
.npmrc
.netrc
.htpasswd

# --- Sauvegardes, archives et fichiers temporaires ---
*.bundle
*.tar
*.tar.gz
*.tgz
*.gpg
*.zip
*.bak
*.orig
*.rej
*.swp
*.tmp
*~

# --- Journaux ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
firewall-events*.json

# --- Hébergeur ---
.vercel

# --- Sources brutes non diffusées ---
# Les assets 3D bruts pèsent plusieurs dizaines de Mo : seule la version optimisée
# de public/models/ est versionnée et servie.
/assets/
/design-src/

# --- Éditeurs et système ---
.vscode/
.idea/
.DS_Store
Thumbs.db
